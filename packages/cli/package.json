{
  "name": "@aimen/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "aimen": "./dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "echo 'cli: dev'",
    "build": "rm -rf dist && bun build ./src/index.ts --outdir ./dist --target node --format esm --external '@aimen/*' --external '@mastra/*' --external zod",
    "lint": "echo 'cli: lint'"
  },
  "dependencies": {
    "@aimen/acp-bus": "workspace:*",
    "@aimen/agents": "workspace:*",
    "@aimen/anytype-gateway": "workspace:*",
    "@aimen/auth": "workspace:*"
  }
}