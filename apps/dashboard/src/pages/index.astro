---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Dashboard">
  <div class="space-y-6 lg:space-y-8 max-w-6xl">
    <!-- Page Header -->
    <div>
      <h1 class="text-xl lg:text-2xl font-bold text-[#F8FAFC]">Dashboard</h1>
      <p class="text-sm text-[#64748B] mt-1 font-body">Agent Orchestration Hub overview</p>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4" id="stats-grid">
      <!-- Agents Online -->
      <div class="bg-[#0F172A] border border-[#1E293B] rounded-xl p-5 transition-all duration-200 hover:border-[#22C55E]/20 hover:shadow-[0_0_20px_rgba(34,197,94,0.05)]">
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-xs font-medium text-[#64748B] font-heading uppercase tracking-wider">Agents Online</h3>
          <div class="w-8 h-8 rounded-lg bg-[#22C55E]/10 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#22C55E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="8" rx="2" ry="2"/>
              <rect x="2" y="14" width="20" height="8" rx="2" ry="2"/>
              <path d="M6 6h.01M6 18h.01"/>
            </svg>
          </div>
        </div>
        <p class="text-3xl font-bold text-[#22C55E] font-heading" id="agent-count">
          <span class="skeleton inline-block w-12 h-8 align-middle"></span>
        </p>
        <p class="text-[10px] text-[#475569] mt-1 font-body">Connected to ACP Bus</p>
      </div>

      <!-- Active Tasks -->
      <div class="bg-[#0F172A] border border-[#1E293B] rounded-xl p-5 transition-all duration-200 hover:border-[#22C55E]/20 hover:shadow-[0_0_20px_rgba(34,197,94,0.05)]">
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-xs font-medium text-[#64748B] font-heading uppercase tracking-wider">Active Tasks</h3>
          <div class="w-8 h-8 rounded-lg bg-[#22C55E]/10 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#22C55E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
              <line x1="9" y1="9" x2="15" y2="9"/>
              <line x1="9" y1="13" x2="15" y2="13"/>
              <line x1="9" y1="17" x2="13" y2="17"/>
            </svg>
          </div>
        </div>
        <p class="text-3xl font-bold text-[#22C55E] font-heading" id="task-count">
          <span class="skeleton inline-block w-12 h-8 align-middle"></span>
        </p>
        <p class="text-[10px] text-[#475569] mt-1 font-body">From agent task queue</p>
      </div>

      <!-- Journal Entries -->
      <div class="bg-[#0F172A] border border-[#1E293B] rounded-xl p-5 transition-all duration-200 hover:border-[#22C55E]/20 hover:shadow-[0_0_20px_rgba(34,197,94,0.05)]">
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-xs font-medium text-[#64748B] font-heading uppercase tracking-wider">Journal Entries</h3>
          <div class="w-8 h-8 rounded-lg bg-[#22C55E]/10 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#22C55E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 20h9"/>
              <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
            </svg>
          </div>
        </div>
        <p class="text-3xl font-bold text-[#22C55E] font-heading" id="journal-count">
          <span class="skeleton inline-block w-12 h-8 align-middle"></span>
        </p>
        <p class="text-[10px] text-[#475569] mt-1 font-body">Today's activity log</p>
      </div>
    </div>

    <!-- Connected Agents Section -->
    <div>
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-sm font-semibold text-[#F8FAFC] font-heading">Connected Agents</h2>
        <div id="agents-status-badge" class="hidden">
          <span class="inline-flex items-center gap-1.5 text-[10px] text-[#22C55E] bg-[#22C55E]/10 px-2.5 py-1 rounded-full font-medium">
            <span class="status-dot online"></span>
            <span id="agents-online-count">0</span> online
          </span>
        </div>
      </div>

      <!-- Agent Cards Container -->
      <div
        id="agents-list"
        class="bg-[#0F172A] border border-[#1E293B] rounded-xl overflow-hidden"
      >
        <!-- Loading skeleton -->
        <div id="agents-loading" class="divide-y divide-[#1E293B]">
          {[1, 2, 3].map((i) => (
            <div class="flex items-center gap-4 p-4">
              <div class="skeleton w-2 h-2 rounded-full flex-shrink-0"></div>
              <div class="flex-1 min-w-0">
                <div class="skeleton h-4 w-32 mb-2"></div>
                <div class="skeleton h-3 w-48"></div>
              </div>
              <div class="skeleton h-6 w-16 rounded-full"></div>
            </div>
          ))}
        </div>

        <!-- Error state -->
        <div id="agents-error" class="hidden p-8 text-center">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-red-500/10 mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#EF4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <line x1="12" y1="8" x2="12" y2="12"/>
              <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
          </div>
          <p class="text-sm font-medium text-[#F8FAFC] mb-1 font-body">Failed to connect to ACP Bus</p>
          <p class="text-xs text-[#64748B] mb-4 font-body">The agent communication bus is unreachable.</p>
          <button
            onclick="loadAgents()"
            class="inline-flex items-center gap-2 px-4 py-2 bg-[#1E293B] hover:bg-[#334155] text-[#F8FAFC] text-sm rounded-lg transition-all duration-200 cursor-pointer min-h-[44px] font-body"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="23 4 23 10 17 10"/>
              <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
            </svg>
            Retry connection
          </button>
        </div>

        <!-- Empty state -->
        <div id="agents-empty" class="hidden p-8 text-center">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-[#1E293B] mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
          </div>
          <p class="text-sm font-medium text-[#F8FAFC] mb-1 font-body">No agents connected</p>
          <p class="text-xs text-[#64748B] font-body">Agents will appear here once they connect to the ACP Bus.</p>
        </div>

        <!-- Agent rows (populated by JS) -->
        <div id="agents-rows" class="hidden divide-y divide-[#1E293B]"></div>
      </div>
    </div>
  </div>
</Layout>

<script>
  async function loadAgents() {
    const loadingEl = document.getElementById('agents-loading');
    const errorEl = document.getElementById('agents-error');
    const emptyEl = document.getElementById('agents-empty');
    const rowsEl = document.getElementById('agents-rows');
    const statusBadge = document.getElementById('agents-status-badge');
    const onlineCountEl = document.getElementById('agents-online-count');
    const agentCountEl = document.getElementById('agent-count');

    // Show loading, hide everything else
    loadingEl.classList.remove('hidden');
    errorEl.classList.add('hidden');
    emptyEl.classList.add('hidden');
    rowsEl.classList.add('hidden');
    rowsEl.innerHTML = '';
    if (statusBadge) statusBadge.classList.add('hidden');

    try {
      const res = await fetch('/api/acp/agents.json');
      const data = await res.json();
      const agents = Array.isArray(data) ? data : (data.agents || []);

      // Update agent count stat
      if (agentCountEl) {
        agentCountEl.textContent = agents.length;
      }

      // Hide loading
      loadingEl.classList.add('hidden');

      if (agents.length === 0) {
        emptyEl.classList.remove('hidden');
        return;
      }

      // Count online
      const onlineCount = agents.filter(a => a.status === 'online').length;
      if (statusBadge && onlineCountEl) {
        onlineCountEl.textContent = onlineCount;
        statusBadge.classList.remove('hidden');
      }

      // Render rows
      rowsEl.innerHTML = agents.map(agent => {
        const status = (agent.status || 'unknown').toLowerCase();
        const statusDotClass = status === 'online' ? 'online' : status === 'busy' ? 'busy' : status === 'offline' ? 'offline' : 'unknown';
        const statusLabel = agent.status || 'Unknown';

        return `
          <div class="flex items-center gap-4 p-4 hover:bg-[#1E293B]/40 transition-all duration-200 cursor-pointer">
            <span class="status-dot ${statusDotClass}"></span>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium text-[#F8FAFC] font-body">${escapeHtml(agent.name || 'Unknown')}</p>
              <p class="text-xs text-[#64748B] font-body truncate mt-0.5">${escapeHtml(agent.id || '')}</p>
            </div>
            <span class="inline-flex items-center gap-1.5 text-[11px] font-medium px-2.5 py-1 rounded-full flex-shrink-0 ${
              status === 'online' ? 'bg-[#22C55E]/10 text-[#22C55E]' :
              status === 'busy' ? 'bg-[#EAB308]/10 text-[#EAB308]' :
              status === 'offline' ? 'bg-[#EF4444]/10 text-[#EF4444]' :
              'bg-[#1E293B] text-[#64748B]'
            }">
              <span class="status-dot ${statusDotClass}" style="width:6px;height:6px;"></span>
              ${escapeHtml(statusLabel)}
            </span>
          </div>
        `;
      }).join('');

      rowsEl.classList.remove('hidden');

    } catch (err) {
      console.error('Failed to load agents:', err);
      loadingEl.classList.add('hidden');
      errorEl.classList.remove('hidden');
      if (agentCountEl) {
        agentCountEl.textContent = '—';
      }
    }
  }

  // Escape HTML for safe template literal insertion
  function escapeHtml(str) {
    if (!str) return '';
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  // Load on page ready
  document.addEventListener('DOMContentLoaded', loadAgents);
</script>