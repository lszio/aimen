---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Dashboard">
  <div class="space-y-8">
    <div>
      <h1 class="text-2xl font-bold">Dashboard</h1>
      <p class="text-neutral-400 mt-1">Agent Orchestration Hub overview</p>
    </div>

    <!-- Agent Status Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4" id="agent-cards">
      <div class="bg-neutral-900 border border-neutral-800 rounded-lg p-4">
        <div class="flex items-center justify-between">
          <h3 class="text-sm font-medium text-neutral-400">Agents Online</h3>
          <span class="text-xs bg-green-600/20 text-green-400 px-2 py-0.5 rounded-full">Live</span>
        </div>
        <p class="text-2xl font-bold mt-2" id="agent-count">—</p>
      </div>

      <div class="bg-neutral-900 border border-neutral-800 rounded-lg p-4">
        <div class="flex items-center justify-between">
          <h3 class="text-sm font-medium text-neutral-400">Active Tasks</h3>
          <span class="text-xs bg-indigo-600/20 text-indigo-400 px-2 py-0.5 rounded-full">ACP</span>
        </div>
        <p class="text-2xl font-bold mt-2">—</p>
      </div>

      <div class="bg-neutral-900 border border-neutral-800 rounded-lg p-4">
        <div class="flex items-center justify-between">
          <h3 class="text-sm font-medium text-neutral-400">Journal Entries</h3>
          <span class="text-xs bg-amber-600/20 text-amber-400 px-2 py-0.5 rounded-full">Today</span>
        </div>
        <p class="text-2xl font-bold mt-2">—</p>
      </div>
    </div>

    <!-- Agent List -->
    <div>
      <h2 class="text-lg font-semibold mb-3">Connected Agents</h2>
      <div class="bg-neutral-900 border border-neutral-800 rounded-lg overflow-hidden" id="agents-list">
        <div class="p-8 text-center text-neutral-500 text-sm">
          Loading agents from ACP Bus...
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  async function loadAgents() {
    try {
      const res = await fetch('/api/acp/agents.json');
      const data = await res.json();
      const agents = Array.isArray(data) ? data : (data.agents || []);

      const countEl = document.getElementById('agent-count');
      if (countEl) countEl.textContent = agents.length;

      const listEl = document.getElementById('agents-list');
      if (!listEl) return;

      if (agents.length === 0) {
        listEl.innerHTML = '<div class="p-8 text-center text-neutral-500 text-sm">No agents connected</div>';
        return;
      }

      listEl.innerHTML = agents.map(agent => `
        <div class="px-4 py-3 border-b border-neutral-800 last:border-b-0 flex items-center justify-between">
          <div>
            <p class="text-sm font-medium">${agent.name || 'Unknown'}</p>
            <p class="text-xs text-neutral-500">${agent.id || ''}</p>
          </div>
          <span class="text-xs ${agent.status === 'online' ? 'bg-green-600/20 text-green-400' : 'bg-neutral-700 text-neutral-400'} px-2 py-0.5 rounded-full">
            ${agent.status || 'unknown'}
          </span>
        </div>
      `).join('');
    } catch (err) {
      console.error('Failed to load agents:', err);
      const listEl = document.getElementById('agents-list');
      if (listEl) {
        listEl.innerHTML = '<div class="p-8 text-center text-neutral-500 text-sm">Failed to connect to ACP Bus</div>';
      }
    }
  }

  loadAgents();
</script>