---
export interface Props {
  title?: string;
  agentCount?: number;
}

const { title = 'aimen', agentCount } = Astro.props;
const user = Astro.locals.user;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — aimen</title>
    <style>
      @import "tailwindcss";
    </style>
  </head>
  <body class="bg-neutral-950 text-white min-h-screen">
    <!-- Header -->
    <header class="border-b border-neutral-800 px-6 py-3">
      <div class="max-w-6xl mx-auto flex items-center justify-between">
        <div class="flex items-center gap-4">
          <a href="/" class="text-xl font-bold tracking-tight hover:text-indigo-400 transition-colors">aimen</a>
          {agentCount !== undefined && (
            <span class="bg-indigo-600/20 text-indigo-300 text-xs px-2 py-0.5 rounded-full font-medium">
              {agentCount} agent{agentCount !== 1 ? 's' : ''}
            </span>
          )}
        </div>
        <nav class="flex items-center gap-4">
          <a href="/" class="text-sm text-neutral-400 hover:text-white transition-colors">Dashboard</a>
          <a href="/tasks" class="text-sm text-neutral-400 hover:text-white transition-colors">Tasks</a>
          <a href="/journal" class="text-sm text-neutral-400 hover:text-white transition-colors">Journal</a>
          {user && (
            <>
              <span class="text-sm text-neutral-500 ml-4">{user.sub}</span>
              <form id="logout-form" method="POST" action="/api/auth/logout">
                <button
                  type="submit"
                  class="text-sm text-neutral-500 hover:text-red-400 transition-colors cursor-pointer"
                >
                  Logout
                </button>
              </form>
            </>
          )}
        </nav>
      </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-6xl mx-auto px-6 py-8">
      <slot />
    </main>

    <script>
      // Handle logout form submission via fetch
      const logoutForms = document.querySelectorAll('#logout-form');
      for (const form of logoutForms) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          try {
            const res = await fetch('/api/auth/logout', { method: 'POST' });
            if (res.ok) {
              window.location.href = '/login';
            }
          } catch (err) {
            console.error('Logout failed', err);
          }
        });
      }
    </script>
  </body>
</html>